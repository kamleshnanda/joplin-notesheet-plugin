{
    "manifest_version": 1,
    "id": "com.kamleshnanda.joplin-notesheet",
    "app_min_version": "3.5",
    "platforms": ["desktop"],
    "version": "1.0.0",
    "name": "Notesheet",
    "description": "Spreadsheets for Joplin. A Joplin note can be a full spreadsheet powered by the Univer SDK — formulas, formatting, sort, filter, charts, and .xlsx import/export.",
    "author": "Kamlesh Nanda",
    "homepage_url": "https://github.com/kamleshnanda/joplin-notesheet-plugin",
    "repository_url": "https://github.com/kamleshnanda/joplin-notesheet-plugin",
    "keywords": ["spreadsheet", "sheet", "table", "formula", "calculation", "xlsx", "excel"],
    "categories": ["productivity", "editor"],
    "icons": {
        "16": "assets/icons/icon16.png",
        "32": "assets/icons/icon32.png",
        "48": "assets/icons/icon48.png",
        "128": "assets/icons/icon128.png"
    }
}
